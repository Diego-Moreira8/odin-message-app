<!DOCTYPE html>
<html lang="pt-BR">
  <%- include("head") %>

  <body>
    <h1>Nova Mensagem</h1>

    <% if (authenticationError) { %>
      <p>Erro de autenticação.</p>
    <% } %>

    <form action="/new" method="post" class="newMessageForm">
      <fieldset>
        <input type="radio" name="authOption" id="login" value="login" checked>
        <label for="login">Já tenho um cadastro</label>
        
        <input type="radio" name="authOption" id="signup" value="signup">
        <label for="signup">Criar uma conta</label>
      </fieldset>

      <div class="formRow">
        <label for="user">Nome de usuário:</label>
        <input type="text" name="user" id="user" maxlength="16" required>
      </div>

      <div class="formRow">
        <label for="password">Senha:</label>
        <input type="password" name="password" id="password" maxlength="16" required>
      </div>

      <div class="formRow">
        <label for="text">Digite aqui sua mensagem:</label>
        <textarea name="text" id="text"></textarea>
      </div>

      <div class="formRow">
        <button type="submit">Enviar</button>
        <a href="/" class="linkAsAButton">Cancelar</a>
      </div>
    </form>
  </body>
</html>